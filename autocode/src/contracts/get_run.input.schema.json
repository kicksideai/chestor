{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "after_seq": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 500
    },
    "before_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Return the preceding event window; zero selects the latest window."
    }
  },
  "required": [
    "run_id"
  ],
  "not": {
    "required": [
      "after_seq",
      "before_seq"
    ]
  }
}
