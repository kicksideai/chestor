{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "agent": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "credential_kind": {
            "type": "string"
          },
          "subscription": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "maxLength": 64
              },
              "base_url": {
                "type": "string",
                "maxLength": 512
              },
              "model": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "base_url"
            ],
            "additionalProperties": false
          },
          "owner": {
            "type": "string"
          },
          "mine": {
            "type": "boolean"
          },
          "usable": {
            "type": "boolean",
            "description": "Eligible for tasks apart from cooldown_until."
          },
          "unavailable_reason": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          },
          "deletable": {
            "type": "boolean"
          },
          "last_used_at": {
            "type": "string"
          },
          "cooldown_until": {
            "type": "string"
          },
          "last_error": {
            "type": "string"
          },
          "runs_day": {
            "type": "integer",
            "minimum": 0
          },
          "failures_day": {
            "type": "integer",
            "minimum": 0
          },
          "rate_limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "window": {
                      "type": "string"
                    },
                    "utilization": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "status": {
                      "enum": [
                        "allowed",
                        "warning",
                        "rejected"
                      ]
                    },
                    "resets_at": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "window",
                    "status"
                  ]
                }
              },
              "overage_status": {
                "enum": [
                  "allowed",
                  "warning",
                  "rejected"
                ]
              },
              "overage_disabled_reason": {
                "type": "string"
              },
              "is_using_overage": {
                "type": "boolean"
              }
            },
            "required": [
              "windows"
            ]
          }
        },
        "required": [
          "id",
          "agent",
          "label",
          "credential_kind",
          "subscription",
          "enabled",
          "owner",
          "mine",
          "usable",
          "writable",
          "deletable",
          "last_used_at",
          "cooldown_until",
          "last_error",
          "runs_day",
          "failures_day"
        ]
      }
    }
  },
  "required": [
    "accounts"
  ]
}
