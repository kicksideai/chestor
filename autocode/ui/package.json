{
  "name": "@chestor/autocode-ui",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "Autocode",
  "description": "Autocode page web component for the chestor/autocode module.",
  "browser": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "type": "module",
  "dependencies": {
    "@kickside/ui-kit": "*",
    "@wippy-fe/theme": "~0.0.56",
    "@wippy-fe/webcomponent-core": "~0.0.56",
    "@wippy-fe/webcomponent-vue": "~0.0.56",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "@wippy-fe/proxy": "~0.0.56",
    "@wippy-fe/vite-plugin": "~0.0.56",
    "happy-dom": "^21.0.4",
    "primevue": "4.5.5",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "~0.0.56",
    "vue": "^3.5.0"
  },
  "wippy": {
    "tagName": "chestor-autocode",
    "type": "component",
    "description": "Starts coding agent tasks in containers across the member's agent accounts, manages those accounts, and streams run output inside KickSide. Accepts no props and loads data through the authenticated Wippy proxy.",
    "props": {
      "type": "object",
      "properties": {}
    },
    "scripts": {
      "build": "build"
    }
  },
  "scripts": {
    "build": "vite build --outDir ../static --emptyOutDir",
    "dev": "vite build --watch --mode development --outDir ../static --emptyOutDir",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "workspaces": [
    "./.wippy/npm/@*/*"
  ]
}
